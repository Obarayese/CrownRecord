{
  "name": "crownrecord",
  "version": "0.4.3",
  "description": "CrownRecord — free Windows screen recorder by Crown Softech",
  "main": "main.js",
  "author": "Crown Softech <support@crownsoftech.com>",
  "homepage": "https://crownsoftech.com/crownrecord",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "start:built": "dist\\win-unpacked\\CrownRecord.exe",
    "dev": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.crownsoftech.crownrecord",
    "productName": "CrownRecord",
    "copyright": "Copyright © Crown Softech",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "logger.js",
      "preload-*.js",
      "*.html",
      "*.css",
      "recorder.js",
      "teleprompter.js",
      "hud.js",
      "mirror.js",
      "assets/**",
      "build/icon.ico"
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "CrownRecord",
      "artifactName": "CrownRecord-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "CrownRecord-${version}-Portable.${ext}"
    }
  }
}
